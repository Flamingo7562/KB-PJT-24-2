<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.badge.mapper.BadgeQueryMapper">

    <!-- constructor 대신 기본 생성자와 리플렉션을 활용하는 유연한 방식으로 변경 -->
    <resultMap id="userBadgeResult" type="com.gighub.badge.dto.UserBadge">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="badgeType" column="badge_type"/>
        <result property="evidence" column="evidence"/>

        <result property="createdAt" column="awarded_at"/>
    </resultMap>

    <select id="findBadgesByUserId" resultMap="userBadgeResult">
        SELECT id, user_id, badge_type, evidence, awarded_at
        FROM user_badges
        WHERE user_id = #{userId}
        ORDER BY awarded_at DESC
    </select>

</mapper>