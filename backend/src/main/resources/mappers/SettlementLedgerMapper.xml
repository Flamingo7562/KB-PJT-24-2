<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.settlement.mapper.SettlementLedgerMapper">

    <!-- DTO가 setter를 갖지 않으므로 생성자 인자로 매핑한다. 인자 순서는 필드 선언 순서를 따른다 -->
    <resultMap id="walletTransactionSnapshotResult"
               type="com.gighub.wallet.dto.WalletTransactionSnapshot">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="walletId" javaType="java.lang.Long"/>
            <arg column="walletUserId" javaType="java.lang.Long"/>
            <arg column="workCaseId" javaType="java.lang.Long"/>
            <arg column="transactionType" javaType="java.lang.String"/>
            <arg column="amount" javaType="java.lang.Long"/>
            <arg column="availableBefore" javaType="java.lang.Long"/>
            <arg column="availableAfter" javaType="java.lang.Long"/>
            <arg column="lockedBefore" javaType="java.lang.Long"/>
            <arg column="lockedAfter" javaType="java.lang.Long"/>
            <arg column="referenceType" javaType="java.lang.String"/>
            <arg column="referenceId" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <select id="findByIdempotencyKeyForShare"
            resultMap="walletTransactionSnapshotResult">
        SELECT wt.id               AS id,
               wt.wallet_id        AS walletId,
               w.user_id           AS walletUserId,
               wt.work_case_id     AS workCaseId,
               wt.transaction_type AS transactionType,
               wt.amount           AS amount,
               wt.available_before AS availableBefore,
               wt.available_after  AS availableAfter,
               wt.locked_before    AS lockedBefore,
               wt.locked_after     AS lockedAfter,
               wt.reference_type   AS referenceType,
               wt.reference_id     AS referenceId
        FROM wallet_transactions wt
        JOIN wallets w ON w.id = wt.wallet_id
        WHERE wt.idempotency_key = #{idempotencyKey}
        FOR SHARE OF wt
    </select>

</mapper>
