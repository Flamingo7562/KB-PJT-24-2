<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.document.mapper.DocumentQueryMapper">

    <resultMap id="documentResult" type="com.gighub.document.dto.Document">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="created_by_user_id" javaType="java.lang.Long"/>
            <arg column="owner_user_id" javaType="java.lang.Long"/>
            <arg column="work_case_id" javaType="java.lang.Long"/>
            <arg column="document_type" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="issued_on" javaType="java.time.LocalDate"/>
            <arg column="expires_on" javaType="java.time.LocalDate"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="documentVersionResult"
               type="com.gighub.document.dto.DocumentVersion">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="document_id" javaType="java.lang.Long"/>
            <arg column="version_no" javaType="java.lang.Integer"/>
            <arg column="version_type" javaType="java.lang.String"/>
            <arg column="storage_key" javaType="java.lang.String"/>
            <arg column="mime_type" javaType="java.lang.String"/>
            <arg column="size_bytes" javaType="java.lang.Long"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="documentListItemResult"
               type="com.gighub.document.dto.DocumentListItem">
        <constructor>
            <idArg column="document_id" javaType="java.lang.Long"/>
            <arg column="type" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="issued_on" javaType="java.time.LocalDate"/>
            <arg column="expires_on" javaType="java.time.LocalDate"/>
            <arg column="owner_name" javaType="java.lang.String"/>
            <arg column="source" javaType="java.lang.String"/>
            <arg column="work_case_id" javaType="java.lang.Long"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="documentShareResult"
               type="com.gighub.document.dto.DocumentShare">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="document_id" javaType="java.lang.Long"/>
            <arg column="work_case_id" javaType="java.lang.Long"/>
            <arg column="shared_with_user_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="findDocumentById" resultMap="documentResult">
        SELECT id, created_by_user_id, owner_user_id, work_case_id,
               document_type, status, issued_on, expires_on,
               created_at, updated_at
        FROM documents
        WHERE id = #{documentId}
    </select>

    <select id="findVersionsByDocumentId" resultMap="documentVersionResult">
        SELECT id, document_id, version_no, version_type,
               storage_key, mime_type, size_bytes, created_at
        FROM document_versions
        WHERE document_id = #{documentId}
        ORDER BY version_no DESC
    </select>

    <select id="findDocuments" resultMap="documentListItemResult">
        SELECT d.id            AS document_id,
        d.document_type AS type,
        d.status        AS status,
        d.issued_on     AS issued_on,
        d.expires_on    AS expires_on,
        u.name          AS owner_name,
        'OWN'           AS source,
        d.work_case_id  AS work_case_id,
        d.created_at    AS created_at
        FROM documents d
        JOIN users u ON u.id = d.owner_user_id
        WHERE d.owner_user_id = #{userId}
        AND d.status != 'DELETED'
        <if test="documentType != null">
            AND d.document_type = #{documentType}
        </if>
        ORDER BY d.created_at DESC, d.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countDocuments" resultType="int">
        SELECT COUNT(*)
        FROM documents d
        WHERE d.owner_user_id = #{userId}
        AND d.status != 'DELETED'
        <if test="documentType != null">
            AND d.document_type = #{documentType}
        </if>
    </select>

    <select id="findSharesByDocumentId" resultMap="documentShareResult">
        SELECT id, document_id, work_case_id, shared_with_user_id,
               status, created_at
        FROM document_shares
        WHERE document_id = #{documentId}
        ORDER BY created_at DESC
    </select>

</mapper>